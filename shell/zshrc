# configure zinit
# Set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone --depth 1 https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"
autoload -Uz compinit && compinit

# Add in zsh plugins
zinit ice depth=1
zinit light zsh-users/zsh-syntax-highlighting
zinit light Aloxaf/fzf-tab
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions

# Save history
HISTFILE=$HOME/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups
setopt auto_cd

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
# flag de cor do ls por SO (GNU: --color / BSD: -G)
# O esquema de cores e o default do proprio sistema; em macOS, quem quiser
# personalizar define LSCOLORS em ~/.zshlocal (o ls novo rejeita hex 0-9).
case "$OSTYPE" in
    darwin*) LS_COLOR_FLAG="-G" ;;
    *) LS_COLOR_FLAG="--color" ;;
esac
zstyle ':fzf-tab:complete:cd:*' fzf-preview "ls $LS_COLOR_FLAG \$realpath"
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview "ls $LS_COLOR_FLAG \$realpath"

#
# Homebrew + PATH base (por SO)
# no macOS, o brew fica ANTES de /usr/local/bin (que já vem do /etc/paths),
# para que o Homebrew ganhe em colisões (ex.: kubectl)
#
case "$OSTYPE" in
    darwin*)
        if [ -x /opt/homebrew/bin/brew ] ; then
            eval "$(/opt/homebrew/bin/brew shellenv zsh)"
        elif [ -x /usr/local/bin/brew ] ; then
            eval "$(/usr/local/bin/brew shellenv zsh)"
        fi
        export PATH="/usr/local/node/bin:$HOME/.zshcustoms/scripts:$PATH"
        ;;
    *)
        export PATH="/usr/local/node/bin:/usr/local/bin:/usr/local/sbin:$HOME/.zshcustoms/scripts:$PATH:/usr/sbin"
        if [ -d /home/linuxbrew ] ; then
            eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
        fi
        ;;
esac

#
# Editor padrão: nvim em todos os SOs
#
if command -v nvim >/dev/null 2>&1 ; then
    alias vi="nvim"
    alias vim="nvim"
    export EDITOR="nvim"
    export VISUAL="nvim"
fi

if [ -d $HOME/.local/bin ] ; then
    export PATH="$PATH:$HOME/.local/bin"
fi

if [ -d $HOME/.yarn ] ; then
    export PATH="$PATH:$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin"
fi

if [ -d $HOME/.deno ] ; then
    export PATH="$PATH:$HOME/.deno/bin"
fi

if [ -d $HOME/.cargo/bin ] ; then
    export PATH="$PATH:$HOME/.cargo/bin"
fi

if [ -d $HOME/.platformio/penv/bin ] ; then
    export PATH="$PATH:$HOME/.platformio/penv/bin"
fi

if [ -d $HOME/.luarocks/bin ] ; then
    export PATH="$PATH:$HOME/.luarocks/bin"
fi

if [ -d $HOME/.bun ] ; then
    if [ -f "$HOME/.bun/_bun" ] ; then
        source "$HOME/.bun/_bun"
    fi
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"

# opencode (binario nativo em ~/.opencode/bin)
if [ -d $HOME/.opencode/bin ] ; then
    export PATH="$PATH:$HOME/.opencode/bin"
fi

source ~/.zshcustoms/shell/aliases

#
# Personalizações por sistema operacional
#
case "$OSTYPE" in
    linux*)  source ~/.zshcustoms/shell/linux/zshrc ;;
    darwin*) source ~/.zshcustoms/shell/macos/zshrc ;;
esac

if [ -f ~/.zshlocal ] ; then
    source ~/.zshlocal
fi

eval "$(starship init zsh)"
eval "$(zoxide init --cmd cd zsh)"
if [ -f "$HOME/.fzf.zsh" ] ; then
    source "$HOME/.fzf.zsh"
elif command -v fzf >/dev/null 2>&1 ; then
    eval "$(fzf --zsh)"
fi
